root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official
# Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Compose rules (io.nlopez.compose.rules): the CompositionLocals Composdown uses internally to pass
# rendering configuration to nested blocks.
compose_allowed_composition_locals = LocalComposdownEnvironment,LocalListDepth
